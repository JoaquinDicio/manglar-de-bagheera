---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Admin" description="Admin panel">
  <section class="d-flex align-items-center flex-column">
    <div class="dash-type">
      <h2>Canjeador de codigos</h2>
      <p>
        Aqui podras verficiar a que premio equivale el código canjeado por tu
        cliente
      </p>
      <form id="code-form" action="post">
        <input required type="text" id="code" placeholder="Codigo" />
        <input id="trade" class="main-button" type="submit" value="Canjear" />
        <p class="error invisible" id="error"></p>
      </form>
    </div>
    <div class="dash-type invisible" id="prize-info">
      <p>Premio: <span id="prize-name"></span></p>
      <p>Email: <span id="prize-email"></span></p>
      <p>Reseña:</p>
      <img id="prize-img" src="" alt="captura de la reseña del usuario" />
    </div>
  </section>
</Layout>

<script>
  import { getPrizeByCode, markAsUsed } from "../db/utils";

  const form = document.getElementById("code-form");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const code = document.getElementById("code").value;
    document.getElementById("error").className = "error invisible"; //reinicia el estado del error

    if (code) {
      document.getElementById("trade").value = "Canjeando...";
      const prize = await getPrizeByCode(code);

      if (prize) {
        //si ya esta usado mostramos el error
        if (prize.used) {
          showError("El premio ya ha sido canjeado");
          document.getElementById("trade").value = "Canjear";
          return;
        }

        document.getElementById("prize-name").textContent = prize.name;
        document.getElementById("prize-email").textContent = prize.email;
        document
          .getElementById("prize-img")
          .setAttribute("src", prize.imageUrl);
        await markAsUsed(prize); // lo marcamos como utilizado
        document.getElementById("prize-info").classList.remove("invisible");

        document.getElementById("trade").value = "Canjear";
      } else {
        showError("El codigo ingresado no es valido");
      }
    }
  });

  function showError(text) {
    document.getElementById("error").textContent = text;
    document.getElementById("error").className = "error";
  }
</script>

<style>
  section {
    background-color: #ebebeb;
    width: 100%;
    padding: 1rem;
    min-height: 100vh;
  }
  div.dash-type {
    max-width: 800px;
    width: 100%;
    border-radius: 5px;
    background-color: #ffff;
    padding: 2rem;
  }
  div.dash-title {
    max-height: fit-content;
    margin-bottom: 1rem;
  }
  h2 {
    margin-bottom: 0.75rem;
  }
  p.total-users {
    font-weight: 500;
    align-items: center;
    color: var(--main-color);
  }
  span {
    font-weight: bold;
    font-size: 1.5rem;
    color: var(--main-color);
    padding: 0.25rem;
  }

  form {
    margin-top: 2rem;
  }

  input {
    padding: 0.5rem 1.5rem;
    border-radius: 5px;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    background-color: beige;
  }

  .main-button {
    color: white;
    background-color: var(--main-color);
    font-weight: bolder;
    width: 100%;
    max-width: 244px;
  }
  .main-button:disabled {
    cursor: none;
    background-color: grey;
  }

  #prize-img {
    border-radius: 10px;
    width: 100%;
    max-width: 500px;
  }

  span {
    font-size: 1.25rem;
  }

  .invisible {
    display: none;
  }

  #error {
    color: red;
    font-size: 1.1rem;
    padding-left: 0.25rem;
  }
</style>
